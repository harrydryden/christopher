# Shared
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ava_dev

# Web (Vercel)
SESSION_SECRET=change-me-to-a-long-random-string
# Public origin, used in emailed links and the Google redirect URI (<APP_URL>/auth/google/callback)
APP_URL=http://localhost:3000
# Optional: "Continue with Google" (an OAuth 2.0 web client in Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Administrator addresses (comma-separated). Default when unset: harryddryden@gmail.com. They may always sign up,
# become administrators once confirmed, and inherit data migrated from a single-user deployment.
# Everyone else can only sign up while an administrator opens registration in Admin.
ADMIN_EMAILS=
# Optional: confirmation and password-reset emails through Resend (APP_URL must be set with them).
# Without a provider the links are written to the server log; AUTH_EMAIL_LOG=0 keeps them out of it.
RESEND_API_KEY=
EMAIL_FROM=

# Worker (Render)
ANTHROPIC_API_KEY=
TZ=Europe/London
# Sent in every request's user agent. Required in production, where a placeholder like this is refused.
SCRAPER_CONTACT_EMAIL=you@example.com
# Optional: the account the operational CLI acts for (default: the earliest administrator)
AVA_CLI_USER=
# Optional: path to a Chromium binary if not using the Playwright Docker image
# CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# CV generation runs in the background worker with ANTHROPIC_API_KEY above.
# Select a separate Claude model in CV builder (default: claude-sonnet-5).

# Vercel-only deployments (shape B in docs/DEPLOY.md): let the cron route run the queue itself,
# not just schedule it. Bounded by the route's maxDuration and with no browser available, so a long
# scan can be cut short and a JavaScript careers page still cannot be read. Leave unset wherever the
# Render worker runs; the route also stands down on its own while the worker's heartbeat is fresh.
# AVA_SERVERLESS_FALLBACK=1

# Optional: authenticates provider-neutral POST /api/newsletters delivery
NEWSLETTER_INGEST_SECRET=

# Large portfolios: scheduled scans spread over this window; manual scans remain immediate.
SCAN_SPREAD_MINUTES=60
# Per-process Chromium contexts. HTTP and AI tasks have their own worker slots.
BROWSER_CONCURRENCY=1
# Optional safety valves (USD) for the deployment as a whole, unlimited unless set. They cap a
# day's spend and a day's discovery spend across every account, over and above the one budget the
# product shows: each account's own monthly budget (default $25), set on Settings or, for anyone,
# in Admin > Accounts.
# DAILY_AI_BUDGET_USD=10
# DISCOVERY_AI_BUDGET_USD=3
