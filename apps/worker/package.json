{
  "name": "@col/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps --import ./dist/otel.mjs dist/index.mjs",
    "start:source": "tsx --import ./src/otel.ts src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node build.mjs",
    "lint": "echo 'no lint configured'",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@col/ai": "workspace:*",
    "@col/core": "workspace:*",
    "@col/db": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "drizzle-orm": "0.45.2",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "8.23.0",
    "playwright": "1.56.1",
    "sharp": "^0.35.4",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.0",
    "vitest": "5.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/exports.ts",
      "default": "./src/exports.ts"
    }
  }
}
