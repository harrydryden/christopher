{
  "name": "@christopher/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "echo 'worker runs from source with tsx'",
    "lint": "echo 'no lint configured'",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@christopher/ai": "workspace:*",
    "@christopher/core": "workspace:*",
    "@christopher/db": "workspace:*",
    "pg": "latest",
    "playwright": "1.56.1",
    "tsx": "latest",
    "drizzle-orm": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "typescript": "~5.9.0",
    "vitest": "latest"
  },
  "exports": {
    ".": {
      "types": "./src/exports.ts",
      "default": "./src/exports.ts"
    }
  }
}
