{
  "name": "ava",
  "private": true,
  "version": "0.1.0",
  "description": "Careers page monitor for a few accounts: one shared company catalogue scanned daily, per-account keyword and location filtered roles, apply/skip learning, similar-company recommendations.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @ava/worker build && pnpm --filter @ava/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev:web": "pnpm --filter @ava/web dev",
    "dev:worker": "pnpm --filter @ava/worker dev",
    "db:generate": "pnpm --filter @ava/db generate",
    "db:migrate": "pnpm --filter @ava/db migrate",
    "smoke:web": "node scripts/smoke-web.mjs",
    "seed:demo": "pnpm --filter @ava/worker exec tsx src/seed-demo.ts",
    "benchmark:scale": "pnpm --filter @ava/worker exec tsx src/benchmark-scale.ts",
    "benchmark:users": "node scripts/benchmark-users.mjs",
    "typecheck:eval": "tsc --noEmit -p tsconfig.scripts.json",
    "test:release": "node --test scripts/*.test.mjs",
    "eval:cv": "tsx scripts/evaluate-cv.ts",
    "acceptance:live": "node scripts/live-acceptance.mjs",
    "recovery:drill": "node scripts/recovery-drill.mjs",
    "capacity:worker": "pnpm --filter @ava/worker exec tsx src/capacity-recovery-drill.ts",
    "check:operations": "node scripts/verify-operational-status.mjs"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "typescript": "~5.9.0",
    "tsx": "4.23.13",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.28"
    },
    "patchedDependencies": {
      "next@15.5.25": "patches/next@15.5.25.patch"
    }
  }
}
