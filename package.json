{
  "name": "christopher",
  "private": true,
  "version": "0.1.0",
  "description": "Careers page monitor for a few accounts: one shared company catalogue scanned daily, per-account keyword and location filtered roles, apply/skip learning, similar-company recommendations.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @christopher/worker build && pnpm --filter @christopher/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev:web": "pnpm --filter @christopher/web dev",
    "dev:worker": "pnpm --filter @christopher/worker dev",
    "db:generate": "pnpm --filter @christopher/db generate",
    "db:migrate": "pnpm --filter @christopher/db migrate",
    "smoke:web": "node scripts/smoke-web.mjs",
    "seed:demo": "pnpm --filter @christopher/worker exec tsx src/seed-demo.ts",
    "benchmark:scale": "pnpm --filter @christopher/worker exec tsx src/benchmark-scale.ts",
    "benchmark:users": "node scripts/benchmark-users.mjs",
    "typecheck:eval": "tsc --noEmit -p tsconfig.scripts.json",
    "test:release": "node --test scripts/*.test.mjs",
    "eval:cv": "tsx scripts/evaluate-cv.ts",
    "acceptance:live": "node scripts/live-acceptance.mjs",
    "recovery:drill": "node scripts/recovery-drill.mjs",
    "capacity:worker": "pnpm --filter @christopher/worker exec tsx src/capacity-recovery-drill.ts",
    "check:operations": "node scripts/verify-operational-status.mjs"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "~5.9.0",
    "tsx": "latest",
    "vitest": "latest"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.28"
    }
  }
}
